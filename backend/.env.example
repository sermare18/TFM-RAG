# Local OpenAI-compatible endpoints
LLAMA_CPP_CHAT_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_CPP_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
OPENAI_API_KEY=local-dev-key

# Local llama.cpp models: embeddings and answer generation only
MODEL_SUPERVISION_ENABLED=true
LOCAL_MODEL_PROFILE=auto
LLAMA_CPP_BINARY=C:\Users\SergioMartinReizabal\Documents\llama.cpp\llama-server.exe
MODELS_DIR=./models
MODEL_LOGS_DIR=./data/logs/models
MODEL_EMBEDDINGS_MODE=managed
MODEL_CHAT_MODE=managed
EMBEDDINGS_CPU_GGUF_PATH=
EMBEDDINGS_GPU_GGUF_PATH=
CHAT_CPU_GGUF_PATH=
CHAT_GPU_GGUF_PATH=
MODEL_START_TIMEOUT=180
MODEL_REQUEST_TIMEOUT=180
MODEL_STOP_TIMEOUT=15
INDEX_JOB_TIMEOUT=1800
MODEL_MAX_RETRIES=1
MODEL_HEALTH_CONNECT_TIMEOUT=5
MODEL_HEALTH_READ_TIMEOUT=10
MODEL_CHAT_IDLE_TIMEOUT=300
MODEL_GPU_LAYERS=999
MODEL_CONTEXT_SIZE=16384
LOCAL_MODEL_HOSTS=

# Amazon Bedrock document-to-Markdown parser
# It stays disabled until the AWS account, region and model are configured.
BEDROCK_ENABLED=false
AWS_PROFILE=
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_PAGES_PER_BATCH=4
BEDROCK_RENDER_DPI=144
BEDROCK_MAX_OUTPUT_TOKENS=16384
BEDROCK_MAX_PAGES_PER_DOCUMENT=200
BEDROCK_MAX_BATCHES_PER_DOCUMENT=50
BEDROCK_REQUEST_TIMEOUT=300
BEDROCK_MAX_RETRIES=1
BEDROCK_REFERENCE_TEXT_MAX_CHARS=12000
BEDROCK_PROMPT_VERSION=claude-sonnet-4-6-page-markdown-v1
BEDROCK_CACHE_DIR=./data/markdown

# Page-bounded chunking
CHUNK_TARGET_TOKENS=700
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=100

# Retrieval: vector, bm25 or hybrid
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=pdf_chunks
TOP_K=8
RETRIEVAL_TOP_K=8
RETRIEVAL_MODE=hybrid
BM25_INDEX_DIR=./data/bm25
RRF_K=60
VECTOR_CANDIDATES=40
BM25_CANDIDATES=40

# Local generation and data
MAX_TOKENS=1024
REASONING_MAX_TOKENS=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_QUERY_INSTRUCTION=Given a user question in Spanish, retrieve relevant passages from the indexed documents that answer the question
DATA_DIR=./data
DOCUMENTS_DIR=./data/pdfs
