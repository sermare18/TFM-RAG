# ===================================================================
# LLM - MODELOS DE LENGUAJE
# ===================================================================
# Endpoint del modelo de chat (llamadas LLM para RAG)
LLAMA_CPP_CHAT_BASE_URL=http://127.0.0.1:8081/v1

# Endpoint del modelo de embeddings/vectorización de texto
LLAMA_CPP_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1

# Token para endpoints OpenAI-compatible locales
OPENAI_API_KEY=local-dev-key

# ===================================================================
# BASE DE DATOS VECTORIAL - LANCEDB
# ===================================================================
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=pdf_chunks
TOP_K=4

# ===================================================================
# CHUNKING - FRAGMENTACIÓN DE DOCUMENTOS
# ===================================================================
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ===================================================================
# GENERACIÓN - PARÁMETROS DE RESPUESTA
# ===================================================================
MAX_TOKENS=1024
REASONING_MAX_TOKENS=1024
REQUEST_TIMEOUT=300

# ===================================================================
# EMBEDDINGS - VECTORIZACIÓN EN BATCH
# ===================================================================
EMBEDDING_BATCH_SIZE=16

# ===================================================================
# DATOS - DIRECTORIOS DE ENTRADA
# ===================================================================
# Directorio base usado por configuración interna
DATA_DIR=./data

# Directorio donde la API guarda/lista documentos subidos
DOCUMENTS_DIR=./data/pdfs

# ===================================================================
# MARKER 2 - PERFILES DEL PIPELINE OFICIAL
# ===================================================================
# Activo Marker full para PDF, Office, EPUB, HTML e imágenes. Si es false,
# conservo fallback nativo para PDF digital, DOCX y TXT.
MARKER_ENABLED=true

# cpu-digital, cpu-quality, gpu-quality o auto. Un valor explícito prevalece
# siempre; auto elige gpu-quality solo si PyTorch ve una NVIDIA utilizable.
MARKER_PROFILE=auto

# cpu-quality usa el backend llama.cpp de Surya.
MARKER_LLAMA_CPP_BINARY=C:\Users\SergioMartinReizabal\Documents\llama.cpp\llama-server.exe

# Umbral secundario para el fallback visual de tablas de Marker 2 balanced.
MARKER_TABLE_MIN_RECON_SCORE=0.75

# Elimina capas OCR existentes antes de re-OCR.
MARKER_STRIP_EXISTING_OCR=false

# Evita guardar imágenes extraídas en disco. Recomendado para RAG textual.
MARKER_DISABLE_IMAGE_EXTRACTION=true

# Rango opcional de páginas en sintaxis Marker, por ejemplo: 0,5-10,20
# Vacío = documento completo.
MARKER_PAGE_RANGE=

# false: JSON estructurado (salida primaria). true: Markdown paginado temporal.
MARKER_MARKDOWN_COMPATIBILITY=false

# ===================================================================
# BÚSQUEDA HÍBRIDA - VECTORIAL + BM25
# ===================================================================
HYBRID_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.65
BM25_WEIGHT=0.35
BM25_TOP_K_MULTIPLIER=3
BM25_INDEX_DIR=./data/bm25
# Evita que BM25 meta resultados con score bruto ridículamente bajo
BM25_MIN_RAW_SCORE=0.25
