# ===================================================================
# LLM - MODELOS DE LENGUAJE
# ===================================================================
# Endpoint del modelo de chat (llamadas LLM para RAG)
LLAMA_CPP_CHAT_BASE_URL=http://127.0.0.1:8081/v1

# Endpoint del modelo de embeddings/vectorización de texto
LLAMA_CPP_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1

# Token para endpoints OpenAI-compatible locales
OPENAI_API_KEY=local-dev-key

# Supervisor de llama.cpp. Los modelos nunca se descargan automáticamente.
MODEL_SUPERVISION_ENABLED=true
LLAMA_CPP_BINARY=C:\Users\SergioMartinReizabal\Documents\llama.cpp\llama-server.exe
MODELS_DIR=./models
MODEL_LOGS_DIR=./data/logs/models

MODEL_START_TIMEOUT=180
MODEL_REQUEST_TIMEOUT=180
MODEL_STOP_TIMEOUT=15
PARSER_JOB_TIMEOUT=1800
MODEL_MAX_RETRIES=1
MODEL_HEALTH_CONNECT_TIMEOUT=5
MODEL_HEALTH_READ_TIMEOUT=10
MODEL_CHAT_IDLE_TIMEOUT=300
MODEL_GPU_LAYERS=999
MODEL_CONTEXT_SIZE=16384

# managed: la aplicación crea/posee el PID. external: solo comprueba /health.
MODEL_SURYA_MODE=managed
MODEL_VLM_MODE=managed
MODEL_EMBEDDINGS_MODE=managed
MODEL_CHAT_MODE=managed

SURYA_BASE_URL=http://127.0.0.1:8084/v1
MARKER_OPENAI_BASE_URL=http://127.0.0.1:8083/v1
MARKER_OPENAI_MODEL=marker-vlm
# Hosts DNS locales adicionales permitidos, separados por comas. IP privadas y
# loopback se aceptan sin añadirlas aquí.
LOCAL_MODEL_HOSTS=

# Rutas opcionales. Vacías = resolver dentro de MODELS_DIR.
SURYA_GGUF_PATH=
SURYA_MMPROJ_PATH=
VLM_CPU_GGUF_PATH=
VLM_CPU_MMPROJ_PATH=
VLM_GPU_GGUF_PATH=
VLM_GPU_MMPROJ_PATH=
VLM_GPU_CUSTOM_GGUF_PATH=
VLM_GPU_CUSTOM_MMPROJ_PATH=
EMBEDDINGS_GGUF_PATH=
CHAT_CPU_GGUF_PATH=
CHAT_GPU_GGUF_PATH=

# ===================================================================
# BASE DE DATOS VECTORIAL - LANCEDB
# ===================================================================
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=pdf_chunks
TOP_K=4

# ===================================================================
# CHUNKING - FRAGMENTACIÓN DE DOCUMENTOS
# ===================================================================
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ===================================================================
# GENERACIÓN - PARÁMETROS DE RESPUESTA
# ===================================================================
MAX_TOKENS=1024
REASONING_MAX_TOKENS=1024
# Compatibilidad con configuraciones antiguas; los clientes de modelos usan
# MODEL_REQUEST_TIMEOUT y Marker usa MARKER_LLM_REQUEST_TIMEOUT.
REQUEST_TIMEOUT=300

# ===================================================================
# EMBEDDINGS - VECTORIZACIÓN EN BATCH
# ===================================================================
EMBEDDING_BATCH_SIZE=16

# ===================================================================
# DATOS - DIRECTORIOS DE ENTRADA
# ===================================================================
# Directorio base usado por configuración interna
DATA_DIR=./data

# Directorio donde la API guarda/lista documentos subidos
DOCUMENTS_DIR=./data/pdfs

# ===================================================================
# MARKER 2 - PERFILES DEL PIPELINE OFICIAL
# ===================================================================
# Activo Marker full para PDF, Office, EPUB, HTML e imágenes. Si es false,
# conservo fallback nativo para PDF digital, DOCX y TXT.
MARKER_ENABLED=true

# cpu-digital, cpu-quality, gpu-quality o auto. Un valor explícito prevalece
# siempre; auto elige gpu-quality solo si PyTorch ve una NVIDIA utilizable.
MARKER_PROFILE=auto

# Presupuestos estrictos del wrapper OpenAI-compatible local de Marker.
MARKER_LLM_MAX_REQUESTS=50
MARKER_LLM_MAX_TOKENS_PER_REQUEST=4096
MARKER_LLM_MAX_GENERATED_TOKENS_PER_DOCUMENT=20000
MARKER_LLM_REQUEST_TIMEOUT=180
MARKER_LLM_JOB_TIMEOUT=1800
MARKER_LLM_MAX_RETRIES=1
MARKER_LLM_FALLBACK_TO_BASE=false

# Umbral secundario para el fallback visual de tablas de Marker 2 balanced.
MARKER_TABLE_MIN_RECON_SCORE=0.75

# Elimina capas OCR existentes antes de re-OCR.
MARKER_STRIP_EXISTING_OCR=false

# Evita guardar imágenes extraídas en disco. Recomendado para RAG textual.
MARKER_DISABLE_IMAGE_EXTRACTION=true

# Rango opcional de páginas en sintaxis Marker, por ejemplo: 0,5-10,20
# Vacío = documento completo.
MARKER_PAGE_RANGE=

# false: JSON estructurado (salida primaria). true: Markdown paginado temporal.
MARKER_MARKDOWN_COMPATIBILITY=false

# ===================================================================
# BÚSQUEDA HÍBRIDA - VECTORIAL + BM25
# ===================================================================
HYBRID_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.65
BM25_WEIGHT=0.35
BM25_TOP_K_MULTIPLIER=3
BM25_INDEX_DIR=./data/bm25
# Evita que BM25 meta resultados con score bruto ridículamente bajo
BM25_MIN_RAW_SCORE=0.25
